# Örnek değerlerdir; gerçek parolayı/anahtarı buraya yazıp depoya göndermeyin.
DATABASE_URL=postgres://kira:deneme@localhost:5432/kiratakipet
PORT=3000
# T.C. kimlik no şifreleme anahtarı: `openssl rand -base64 32` ile üretin, yedeklerle birlikte güvenli yerde saklayın.
# Kaybolursa kayıtlı T.C. numaraları okunamaz.
VERI_ANAHTARI=
# Canlıda (HTTPS arkasında) 1 yapın.
GUVENLI_CEREZ=0
